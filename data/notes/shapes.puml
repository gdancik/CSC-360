@startuml
skinparam classAttributeIconSize 0

abstract class Shape {
  -color: String
  +Shape(color: String)
  +{abstract} calculateArea(): double
  +displayColor(): void
}

class Circle {
  -radius: double
  +Circle(color: String, radius: double)
  +calculateArea(): double
}

class Rectangle {
  -width: double
  -height: double
  +Rectangle(color: String, width: double, height: double)
  +calculateArea(): double
}

note top of Shape
Italics indicates abstract class
end note

note right of Shape::calculateArea
Italics indicates abstract method
end note

note left of Shape::displayColor
Regular text indicates a concrete method
end note

'Denote inheritance using using A --|> B for A inherits from B
Circle --|> Shape
Rectangle --|> Shape
@enduml